# Sao chép thành .env (chmod 600). setup.sh tự sinh METRICS_TOKEN và FRAUD_ADMIN_PASSWORD nếu để trống.

# Tên miền (DuckDNS: tạo thêm 1 subdomain, VD laichan-demo.duckdns.org) trỏ về IP của VM
TELECOM_DOMAIN=
# Mật khẩu ban đầu cho tài khoản admin vận hành (đăng nhập ở /admin/)
FRAUD_ADMIN_USER=viettel_admin
FRAUD_ADMIN_PASSWORD=
# Email Google của bạn để đăng nhập /admin/ bằng nút Google (tuỳ chọn)
FRAUD_ADMIN_EMAIL=
# Dùng chung OAuth client với FieldOps được: thêm https://TELECOM_DOMAIN vào Authorized JavaScript origins
GOOGLE_CLIENT_ID=
# Bearer token cho Grafana Cloud scrape https://TELECOM_DOMAIN/metrics
METRICS_TOKEN=

# 1 = phát lại lưu lượng MÔ PHỎNG (bản công khai); 0 = chế độ thật (cần lưu lượng nhà mạng + OTP SMS)
FRAUD_DEMO=1
# OTP SMS cho chế độ thật: twilio | sms-http. (console ghi mã OTP ra log nên chỉ chạy được khi FRAUD_DEMO=1)
# Cấu hình sai (thiếu biến, URL không https, mẫu JSON hỏng) làm server dừng ngay lúc khởi động.
FRAUD_OTP_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_COST_USD=0.08

FRAUD_BACKUP_KEEP=7
FRAUD_PIPELINE_DAILY_AT=02:30
DUCKDNS_TOKEN=

# --- OTP qua API SMS / brandname của nhà mạng (FRAUD_OTP_PROVIDER=sms-http)
FRAUD_SMS_HTTP_URL=
# Đường dẫn TRONG container; chép file token vào volume:  docker compose cp sms_token telecom:/srv/state/secrets/sms_token
FRAUD_SMS_HTTP_TOKEN_FILE=
# Mẫu JSON; {phone} {phone_plus} {message} {brandname} được điền. Để trống = {"to","from","text"}.
FRAUD_SMS_HTTP_BODY=
FRAUD_SMS_HTTP_OK_FIELD=
FRAUD_SMS_HTTP_OK_VALUE=
FRAUD_SMS_BRANDNAME=

# --- Web Push (khoá VAPID tự sinh trong volume /srv/state/secrets; backup cùng volume)
FRAUD_PUSH=1
# Liên hệ cho dịch vụ push, VD mailto:security@ten-mien-cua-ban (để trống = địa chỉ placeholder)
FRAUD_VAPID_SUBJECT=

# --- Chỉ đặt 1 sau khi đã kiểm định trên lưu lượng thật có nhãn (mở chế độ enforce)
FRAUD_REAL_TRAFFIC_VALIDATED=0
# Độ bền nhật ký phán quyết: FULL (mặc định, quyết định 17/11/2026). NORMAL chỉ dùng khi thử.
FRAUD_SQLITE_SYNCHRONOUS=FULL
# Giới hạn body request (byte), trừ /api/v1/audio có giới hạn riêng
FRAUD_MAX_BODY_BYTES=1048576
# Chế độ demo: file bằng chứng xoay vòng ở mức này (MB), giữ 1 bản cũ
FRAUD_DEMO_EVIDENCE_MAX_MB=256
LOG_LEVEL=warning
# IP của Caddy chung (deploy.sh/setup.sh tự điền bằng proxy_ip.sh); tên container nếu khác mặc định
FORWARDED_ALLOW_IPS=
TELECOM_PROXY_CONTAINER=
