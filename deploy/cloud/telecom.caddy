# Site Telecom cho Caddy chung (setup.sh thay __DOMAIN__ rồi chép vào /opt/edge/sites/).
__DOMAIN__ {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	request_body {
		max_size 16MB
	}
	reverse_proxy telecom:8080
}
