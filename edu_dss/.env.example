# Optional deployment overrides. Secrets are provisioned into ./secrets, not .env.
JWT_ISSUER=edu-dss
# Required outside demo mode: the API refuses tokens whose aud differs (N6).
JWT_AUDIENCE=edu-dss-api
EDU_EXPLANATION_ADAPTER=
EDU_ADVICE_ADAPTER=
EDU_AUTOML_ADAPTER=
EDU_GRADE_ADAPTER=
EDU_LLM_REQUESTS_PER_MINUTE=60
EDU_LLM_TASK_RATE_LIMIT=5/m
CELERY_CONCURRENCY=2
NGINX_TLS_DIR=./secrets/tls
