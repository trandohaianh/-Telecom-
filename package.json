{
  "name": "telecom-fraud-shield-static",
  "private": true,
  "description": "Lint/format tooling for the browser scripts in static/ (no build step, nothing is bundled).",
  "scripts": {
    "lint": "eslint static",
    "format:check": "prettier --check \"static/**/*.js\"",
    "format": "prettier --write \"static/**/*.js\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1"
  }
}
